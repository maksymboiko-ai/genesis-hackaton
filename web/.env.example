# Copy to web/.env.local and fill in. Never commit real values.

# "supabase" (default) or "memory" (no database, data lives in the dev server process)
STORE=supabase
SUPABASE_URL=https://<project>.supabase.co
# Server-only key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Private storage bucket for uploaded PDFs
SUPABASE_BOOKS_BUCKET=books

# "real" (default) calls lib/ai through OpenRouter; "fake" returns canned objects
AI_MODE=real
OPENROUTER_API_KEY=

# Model calls allowed per rolling 24 hours
DAILY_LLM_CALL_LIMIT=3000

# Accounts that may open /admin (the analytics dashboard), separated by
# commas. They sign in like any parent. Empty: nobody.
ADMIN_EMAILS=

# Frontend: "false" makes the app call this backend's /api. Anything else (or
# unset) keeps the in-browser mock API, which needs no backend.
NEXT_PUBLIC_API_MOCK=false
